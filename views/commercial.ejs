<section class="phero">
  <img src="<%= site.img.hd %>" alt="" class="ph">
  <div class="wrap">
    <%- include('partials/crumbs') %>
    <h1>Commercial Window Treatments <em>in NYC</em></h1>
    <p>Shades, blinds and drapery for offices, hospitality, healthcare and multifamily buildings &mdash; specified, measured and installed by one accountable team.</p>
  </div>
