<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="phero">
  <img src="<%= site.img.panels %>" alt="" class="ph">
  <div class="wrap">
    <%- include('partials/crumbs') %>
    <h1>Contact <em>Horizon</em></h1>
    <p>Visit our Chelsea showroom, give us a call, or send a message and a designer will get back to you within one business day.</p>
  </div>
</section>
<section class="sec">
  <div class="wrap feature-grid">
    <div class="prose">
      <h2>Visit our showroom</h2>
      <p class="foot-contact" style="font-size:18px"><b><%= site.address.street %><br>New York, NY <%= site.address.zip %></b></p>
      <p>Walk-ins are welcome; we recommend calling ahead so a designer is available for you.</p>
      <p><a class="btn btn-black" href="tel:<%= site.phoneTel %>" data-track="call-contact"><%= site.phone %></a> &nbsp; <a class="btn btn-outline" href="mailto:<%= site.email %>"><%= site.email %></a></p>
      <div style="border-radius:10px;overflow:hidden;margin-top:28px;box-shadow:var(--shadow)">
        <iframe title="Map to Horizon Window Treatments showroom" src="https://maps.google.com/maps?q=<%= encodeURIComponent(site.address.street + ', New York, NY ' + site.address.zip) %>&z=15&output=embed" width="100%" height="340" style="border:0;display:block" loading="lazy"></iframe>
      </div>
    </div>
    <aside class="sticky"><%- include('partials/lead-form', { formTitle: 'Send Us a Message', formSub: 'We respond within one business day.', formName: 'Contact page' }) %></aside>
  </div>
</section>
<%- include('partials/footer') %>
